modules = ["nodejs-20"]
run = "npm run deploy:replit"
entrypoint = "server/src/index.ts"
hidden = [".config", "package-lock.json", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"

[deployment]
run = ["sh", "-c", "npm run deploy:replit"]
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 4000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[userenv]

[userenv.shared]
JWT_SECRET = "math-ranked-jwt-secret-key-2024"
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && NODE_ENV=production node_modules/.bin/tsx src/index.ts"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
